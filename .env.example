# =====================================================================
# NexaAI - Environment Configuration Template (.env.example)
#
# Copy this file to .env and supply local development secrets.
# NEVER commit real credentials, production secrets, or API keys.
# =====================================================================

# --- Infrastructure Published Ports (Host) ---------------------------
# Default: 5432
POSTGRES_PORT=
# Default: 6379
REDIS_PORT=
# Default: 9092
KAFKA_PORT=
# Default: 8089
EDGE_PORT=

# --- Microservices Published Ports (Host) ----------------------------
# Default: 8080
API_GATEWAY_PORT=
# Default: 8081
AUTH_SERVICE_PORT=
# Default: 8082
USER_SERVICE_PORT=
# Default: 8083
CHAT_SERVICE_PORT=
# Default: 8084
AI_SERVICE_PORT=
# Default: 8085
DOCUMENT_SERVICE_PORT=
# Default: 8086
RAG_SERVICE_PORT=
# Default: 8087
SUBSCRIPTION_SERVICE_PORT=
# Default: 8088
ANALYTICS_SERVICE_PORT=
# Default: 5173
FRONTEND_PORT=

# --- PostgreSQL Database Credentials ---------------------------------
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
CHAT_DB_PASSWORD=
DOCUMENT_DB_PASSWORD=
RAG_DB_PASSWORD=
SUBSCRIPTION_DB_PASSWORD=
ANALYTICS_DB_PASSWORD=

# --- Kafka & Redis Configuration -------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=
REDIS_HOST=localhost
REDIS_PORT=

# --- Security & JWT Keys ----------------------------------------------
JWT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- AI Provider API Keys (AI Service) --------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Razorpay Payment Gateway (Subscription Service - TEST MODE ONLY) -
# Pinned to test mode: test
RAZORPAY_MODE=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Frontend Web Application (Vite / React) -------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_GATEWAY_URL=http://localhost:8080
VITE_DEV_GATEWAY_URL=http://localhost:8080
