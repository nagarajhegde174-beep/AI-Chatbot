# =====================================================================
# NexaAI
#
# The single most important job of this file is the secrets section below.
# Everything else is ordinary build noise.
# =====================================================================

# ---------------------------------------------------------------- build ----
# Maven
target/
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar

# Node / Vite
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------- secrets ----
# Real values must never be committed. Only .env.example placeholders belong
# in the repository. See docs/RULES.md section 6.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
secrets.*
id_rsa
id_ed25519

# --------------------------------------------------------------- local ----
# Local infrastructure state
postgres-data/
kafka-data/
redis-data/
*.log

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
nbproject/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS binaries produced by native builds
*.exe
*.dll
*.so
*.dylib

# ------------------------------- generated API documentation ---------------
# Only GENERATED documentation is ignored. The seven documents in docs/ are
# source code and are tracked.
site/
apidocs/
**/target/site/
**/target/jacoco/

# NOTE: docs/ itself is deliberately NOT ignored. A bare `docs/` line appeared
# here twice during Phase 0/1 and silently excluded every document from the
# repository while the files still existed on disk and CI reported green.
# CI check R13 fails the build if that line ever returns.


