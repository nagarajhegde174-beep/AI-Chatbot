# NexaAI frontend environment.
#
# Copy to `.env.local` and fill in values for your machine. `.env.local` is
# gitignored and must NEVER be committed.
#
# =====================================================================
#  THIS FILE MAY ONLY EVER CONTAIN PUBLIC VALUES.
# =====================================================================
#
# Vite inlines every `VITE_*` variable into the JavaScript bundle, which means
# anything listed here is readable by every user in a browser devtools console.
#
# Therefore this project has NO AI provider keys, NO payment key secret and NO
# signing key in the frontend, and there is no variable here that would hold one.
# Those credentials live in ai-service and subscription-service as server-side
# environment variables only.
#
# See docs/RULES.md section 6 and docs/SECURITY.md section 5.
# =====================================================================

# Base URL of the API Gateway.
#
# Empty in development: the Vite dev server proxies `/api` to the gateway, so
# requests are same-origin and this stays empty. Set it only when the API is on
# a different host, for example in a deployed environment. This value is public
# by definition.
VITE_API_BASE_URL=

# Gateway URL used by the Vite dev-server proxy for `/api`. Development only.
# Never reaches the bundle; it is read by vite.config.ts, not by application
# code.
VITE_DEV_GATEWAY_URL=http://localhost:8080