# NexaAI frontend environment.
#
# Copy to `.env.local` and fill in values for your machine. `.env.local` is gitignored
# and must NEVER be committed.
#
# HARD RULE: this file may only ever contain PUBLIC values. Vite inlines every
# VITE_* variable into the JavaScript bundle, which means anything listed here is
# visible to every user in a browser. Never put an API key, a signing secret, a
# database password or a Razorpay key secret here. See docs/RULES.md section 6.

# Base URL of the API Gateway. In development the Vite proxy forwards /api, so this
# stays empty and requests are same-origin. Set it only when the API is on another
# host, for example a deployed environment.
VITE_API_BASE_URL=

# Gateway URL used by the Vite dev-server proxy for /api. Development only.
VITE_DEV_GATEWAY_URL=http://localhost:8080
