# =====================================================================
# NexaAI infrastructure environment.
#
# Copy to `.env` in this directory and fill in real values.
# `.env` is gitignored and must NEVER be committed. This file holds no real
# secret: every value below is a placeholder or a local default.
#
# Every variable here is read by infrastructure/docker-compose.yml as a
# *host-side* variable. It is never baked into an image, and it never reaches
# the frontend bundle. See docs/RULES.md section 6.
#
# =====================================================================
#  PHASE 0 SCOPE.
#
#  Only the port and infrastructure variables below are used today, because
#  only PostgreSQL, Redis, Kafka and NGINX exist. The per-service variables
#  (database credentials, AI keys, Razorpay, JWT keys) are listed so that a
#  developer sees the whole planned configuration, and they are added to the
#  Compose file when each service is implemented.
#
#  They are documented, not wired. Listing a variable that nothing reads would
#  suggest configuration that does not exist.
# =====================================================================
# =====================================================================

# --- published host ports (local development only) --------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
EDGE_PORT=8089

# --- planned ports, used when each service is implemented -------------------
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
DOCUMENT_SERVICE_PORT=8085
RAG_SERVICE_PORT=8086
SUBSCRIPTION_SERVICE_PORT=8087
FRONTEND_PORT=8088

# --- infrastructure ----------------------------------------------------------
# Local development placeholder. NOT a secret, and NOT usable anywhere else.
POSTGRES_ADMIN_PASSWORD=nexa_admin_local_pw

# Fixed for local development so the Kafka volume can be reused between runs.
# A real environment generates a unique cluster id per deployment.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- per-service database credentials (Phase 1 onward) ----------------------
# Each service connects to its own database with its own role. These are local
# placeholders matching
# infrastructure/docker/postgres/init/01-create-databases.sql.
# Real deployments inject them from a secret store.
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
CHAT_DB_PASSWORD=
DOCUMENT_DB_PASSWORD=
RAG_DB_PASSWORD=
SUBSCRIPTION_DB_PASSWORD=

# --- JWT signing keys (Phase 1 onward) --------------------------------------
# Path to the RS256 private key, mounted into auth-service from outside the
# repository. The key file is gitignored and never committed.
# Generate a local pair with the command in docs/SECURITY.md section 2.
JWT_PRIVATE_KEY_PATH=

# --- AI provider keys (Phase 4 onward) ---------------------------------------
# Read only by ai-service, and by rag-service for embeddings. Never exposed to
# the browser and never written to a log.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Razorpay (Phase 9 onward) — TEST MODE ONLY -----------------------------
# There is deliberately no live-mode variable. RAZORPAY_MODE is pinned to
# `test` in docker-compose.yml and the service refuses to start otherwise.
# The public test key id may be returned to the browser; the secret may not.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- frontend build (Phase 10 onward) ---------------------------------------
# Public value only, inlined into the bundle at build time. Never a secret.
VITE_API_BASE_URL=