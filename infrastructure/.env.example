# =====================================================================
# NexaAI infrastructure environment.
#
# Copy to `.env` in this directory and fill in real values.
# `.env` is gitignored and must NEVER be committed. This file holds no real
# secret: every value below is a placeholder or a local default.
#
# Every variable here is read by infrastructure/docker-compose.yml as a
# *host-side* variable. It is never baked into an image, and it never reaches
# the frontend bundle. See docs/RULES.md section 6.
# =====================================================================

# --- published host ports (local development only) --------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
DOCUMENT_SERVICE_PORT=8085
RAG_SERVICE_PORT=8086
SUBSCRIPTION_SERVICE_PORT=8087
FRONTEND_PORT=8088
EDGE_PORT=8089

# --- infrastructure ----------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=nexa_admin_local_pw

# Fixed for local development so the Kafka volume can be reused between runs.
# A real environment generates a unique cluster id per deployment.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- per-service database credentials ---------------------------------------
# Each service connects to its own database with its own role. These are local
# placeholders matching infrastructure/docker/postgres/init/01-create-databases.sql.
# Real deployments inject them from a secret store.
AUTH_DB_PASSWORD=nexa_auth_local_pw
USER_DB_PASSWORD=nexa_user_local_pw
CHAT_DB_PASSWORD=nexa_chat_local_pw
DOCUMENT_DB_PASSWORD=nexa_document_local_pw
RAG_DB_PASSWORD=nexa_rag_local_pw
SUBSCRIPTION_DB_PASSWORD=nexa_subscription_local_pw

# --- JWT signing keys -------------------------------------------------------
# Path to the RS256 private key, mounted into auth-service from outside the
# repository. The key file is gitignored and never committed.
# Generate a local pair with the command in docs/SECURITY.md.
JWT_PRIVATE_KEY_PATH=

# --- AI provider keys -------------------------------------------------------
# Read only by ai-service, and by rag-service for embeddings. They are never
# exposed to the browser and never written to a log.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Razorpay (TEST MODE ONLY) ----------------------------------------------
# There is deliberately no live-mode variable. RAZORPAY_MODE is pinned to `test`
# in docker-compose.yml and the service refuses to start otherwise.
# The public test key id may be returned to the browser; the secret may not.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- frontend build ---------------------------------------------------------
# Public value only, inlined into the bundle at build time. Never a secret.
VITE_API_BASE_URL=
